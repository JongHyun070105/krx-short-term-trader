# Copy to .env and fill credentials locally. Never commit .env.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_HTS_ID=

TRADING_MODE=shadow
LIVE_TRADING_ENABLED=false
MAX_LIVE_CAPITAL_KRW=100000
MAX_ORDER_NOTIONAL_KRW=20000
MAX_CONCURRENT_POSITIONS=2
RISK_PER_TRADE_PCT=0.25
MAX_DAILY_LOSS_PCT=0.75
MAX_DAILY_TRADES=4
MIN_PRICE_KRW=1000
MAX_PRICE_KRW=50000

# Defaults are explicit assumptions. Replace with your verified KIS fee/tax schedule.
BROKER_FEE_RATE=0.00015
SELL_TAX_RATE=0.0020
SLIPPAGE_BPS=15
REGIME_TREND_LOOKBACK=20
REGIME_VOLATILITY_LOOKBACK=20
REGIME_HIGH_VOL_THRESHOLD=0.025
